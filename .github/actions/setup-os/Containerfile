# Prebuilt CI image: the base distro image plus everything installed by the
# setup-<distro>.sh scripts. Built and published by .github/workflows/ci-images.yml.

ARG BASE
FROM ${BASE}

COPY setup-*.sh /tmp/setup-os/
RUN . /etc/os-release && /tmp/setup-os/setup-${ID}.sh && rm -rf /tmp/setup-os
